{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vitest/globals"],
    "jsx": "react-jsx"
  },
  "include": ["src"],
  // src/cli, src/mcp and their scenario drivers are Node programs with their own types (tsconfig.cli.json); the app never sees Node's.
  "exclude": [
    "src/cli",
    "src/mcp",
    "src/scenarios/drivers/cli.ts",
    "src/scenarios/drivers/cli.test.ts",
    "src/scenarios/drivers/mcp.ts",
    "src/scenarios/drivers/mcp.test.ts"
  ]
}
